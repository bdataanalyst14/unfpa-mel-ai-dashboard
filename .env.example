DATA_MODE=mock
GOOGLE_CLOUD_PROJECT_ID=
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=
BIGQUERY_LOCATION=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PRIVATE_KEY_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_MAX_BYTES_BILLED=
BIGQUERY_CACHE_TTL_SECONDS=300
ENABLE_GBV_SUPPRESSION=true

# Application authentication (server-only; required for live BigQuery mode)
AUTH_SECRET=
NEXTAUTH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DASHBOARD_AUTH_REQUIRED=true
# Comma-separated server-only authorization allowlists; default deny when empty.
DASHBOARD_AUTHORIZED_EMAILS=
DASHBOARD_ADMIN_EMAILS=
KOBO_ASSET_CONFIG_FILE=
KOBO_SECRET_DIR=
KOBO_APPROVED_HOSTS=https://kf.kobotoolbox.org,https://eu.kobotoolbox.org
PIPELINE_MODE=incremental
PIPELINE_MIN_PARTICIPANT_ROWS=
PIPELINE_MIN_ACTIVITY_ROWS=
PIPELINE_APPROVAL_REFERENCE=
EMPTY_REPLACEMENT_APPROVAL_REFERENCE=
ALLOW_VERIFIED_EMPTY_SOURCE_REPLACEMENT=false
BACKUP_ENABLED=false
SHARED_DRIVE_FOLDER_ID=
SHARED_DRIVE_ID=
BACKUP_ENCRYPTION_KEY_FILE=
BACKUP_INCLUDE_PARTICIPANTS=false
BACKUP_RETENTION_MONTHS=12
