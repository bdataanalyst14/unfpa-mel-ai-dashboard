# Runtime mode
DATA_MODE=mock
DASHBOARD_DATA_MODE=mock

# Required only when the approved runtime mode is bigquery
BIGQUERY_PROJECT_ID=<server-only-project-id>
BIGQUERY_DATASET_ID=<server-only-dataset-id>
BIGQUERY_LOCATION=<approved-region>

# Use only when workload identity or another approved credential mechanism is unavailable
GOOGLE_CLIENT_EMAIL=<server-only-service-account-email>
GOOGLE_PRIVATE_KEY_FILE=/etc/unfpa-mel/secrets/google-private-key.pem
# Alternative server-only ADC mode; do not configure with the PEM variables above
GOOGLE_APPLICATION_CREDENTIALS=

# Optional server-only controls
BIGQUERY_MAX_BYTES_BILLED=<approved-query-byte-limit>
BIGQUERY_CACHE_TTL_SECONDS=300
ENABLE_GBV_SUPPRESSION=true
KOBO_ASSET_CONFIG_FILE=/etc/unfpa-mel-dashboard/kobo-assets.json
KOBO_SECRET_DIR=/etc/unfpa-mel/secrets/kobo
KOBO_APPROVED_HOSTS=https://kf.kobotoolbox.org,https://eu.kobotoolbox.org
PIPELINE_MIN_PARTICIPANT_ROWS=<approved-minimum>
PIPELINE_MIN_ACTIVITY_ROWS=<approved-minimum>
PIPELINE_APPROVAL_REFERENCE=
EMPTY_REPLACEMENT_APPROVAL_REFERENCE=
ALLOW_VERIFIED_EMPTY_SOURCE_REPLACEMENT=false
BACKUP_ENABLED=false
SHARED_DRIVE_FOLDER_ID=<official-folder-id>
SHARED_DRIVE_ID=<official-drive-id>
BACKUP_ENCRYPTION_KEY_FILE=/etc/unfpa-mel/secrets/backup-encryption.key
BACKUP_INCLUDE_PARTICIPANTS=false
BACKUP_RETENTION_MONTHS=12

# No NEXT_PUBLIC_* variables are currently approved
