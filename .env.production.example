# Runtime mode
DATA_MODE=bigquery
DASHBOARD_DATA_MODE=bigquery

# Required only when the approved runtime mode is bigquery
GOOGLE_CLOUD_PROJECT_ID=unfpadatabase
BIGQUERY_PROJECT_ID=unfpadatabase
BIGQUERY_DATASET_ID=unfpadatabase
BIGQUERY_LOCATION=asia-south1

# Server-only authentication. Configure exactly one mode at deployment time.
# Vercel credential configuration is a separate controlled checkpoint.
# Vercel WIF mode (server-only; configure all four values together)
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Local/external PEM mode
GOOGLE_CLIENT_EMAIL=<server-only-service-account-email>
GOOGLE_PRIVATE_KEY_FILE=<external-server-only-pem-path>
# Alternative local ADC mode; configure exactly one authentication mode
GOOGLE_APPLICATION_CREDENTIALS=

# Optional server-only controls
BIGQUERY_MAX_BYTES_BILLED=1000000000
BIGQUERY_CACHE_TTL_SECONDS=300
ENABLE_GBV_SUPPRESSION=true

# No NEXT_PUBLIC_* variables are currently approved

# Google OAuth application authentication (server-only placeholders)
# Configure only after an approved Google OAuth Web client exists.
AUTH_SECRET=
NEXTAUTH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_AUTHORIZED_EMAILS=
DASHBOARD_ADMIN_EMAILS=
